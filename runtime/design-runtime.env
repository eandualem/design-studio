# Design Studio runtime environment: the settings one assistant-runtime needs
# to serve this app's text chat, live voice and design decisions. No secrets
# live here: the Codex login funds openai: models, OPENAI_API_KEY (in the
# runtime's own .env) funds GPT-Live audio, CEREBRAS_API_KEY the fast design
# candidates.
#
# You start the runtime yourself; the studio only checks it is there. From an
# assistant-runtime checkout, with the two absolute paths filled in:
#
#   ASSISTANT__PROFILE=/absolute/path/to/design-studio/profiles/design-studio.toml \
#   VOICE__CONVERSATION_INSTRUCTIONS_FILE=/absolute/path/to/design-studio/profiles/live-instructions.md \
#   uv run --env-file /absolute/path/to/design-studio/runtime/design-runtime.env \
#     assistant-runtime serve --host 127.0.0.1 --port 7100
#
# (An installed package: `set -a; . runtime/design-runtime.env; set +a` then
# `assistant-runtime serve`.) Without a Codex login, drop the two Codex lines
# and name your provider's model.

OAUTH__CODEX_AUTO_SYNC=true
LLM__CODEX_ONLY=true
LLM__PRIMARY_MODEL=openai:gpt-5.6-sol
ASSISTANT__THINKING_BUDGET=4000
ASSISTANT__ENABLE_WORKING_MEMORY=false
TOOLS__BUILTIN_TOOLS='["time","screen"]'

# Design decisions choose their model per request from the app (the Design
# model control; NEXT_PUBLIC_DESIGN_MODEL as the app's default). Left empty,
# any model of a configured provider may be requested; list the allowed ones
# for a deployment.
# ASSISTANT__REQUEST_MODELS=["cerebras:qwen-3.8-27b","openai:gpt-6-astra"]

# Voice: GPT-Live, conversation only. Editing belongs to the app's design controller.
VOICE__ENABLED=true
VOICE__DELEGATION_ENABLED=false
VOICE__MODEL=gpt-live-1
VOICE__MAX_SESSIONS=1
VOICE__MAX_DURATION_SECONDS=600
