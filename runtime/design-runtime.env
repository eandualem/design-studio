# Design Studio runtime launch file: one assistant-runtime on 7100 serves text
# chat, the live voice and the design controller's decisions. No secrets live
# here: the Codex login funds openai: models, OPENAI_API_KEY (in the runtime's
# own .env) funds GPT-Live audio, CEREBRAS_API_KEY the fast design candidates.
# Start it with `make runtime` (scripts/runtime-up.sh), which sets
# ASSISTANT__PROFILE and VOICE__CONVERSATION_INSTRUCTIONS_FILE to absolute
# paths in this repository. Shell variables override values below; without a
# Codex login, drop the two Codex lines and name your provider's model.

OAUTH__CODEX_AUTO_SYNC=true
LLM__CODEX_ONLY=true
LLM__PRIMARY_MODEL=openai:gpt-5.6-sol
ASSISTANT__THINKING_BUDGET=4000
ASSISTANT__ENABLE_WORKING_MEMORY=false
# ASSISTANT__PROFILE is set by scripts/runtime-up.sh (profiles/design-studio.toml).
TOOLS__BUILTIN_TOOLS='["time","screen"]'

# Design decisions choose their model per request from the app (the Design
# model control; NEXT_PUBLIC_DESIGN_MODEL as the app's default). Left empty,
# any model of a configured provider may be requested; list the allowed ones
# for a deployment.
# ASSISTANT__REQUEST_MODELS=["cerebras:qwen-3.8-27b","openai:gpt-6-astra"]

# Voice: GPT-Live, conversation only. Editing belongs to the app's design controller.
VOICE__ENABLED=true
VOICE__DELEGATION_ENABLED=false
VOICE__MODEL=gpt-live-1
VOICE__MAX_SESSIONS=1
VOICE__MAX_DURATION_SECONDS=600
# VOICE__CONVERSATION_INSTRUCTIONS_FILE is set by scripts/runtime-up.sh (profiles/live-instructions.md).
